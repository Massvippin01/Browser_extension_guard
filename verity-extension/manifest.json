{
  "manifest_version": 3,
  "name": "Verity",
  "version": "1.0",
  "description": "Real-time, on-device evaluator for website authenticity. Protects against financial phishing and impersonation.",
  "permissions": [
    "webNavigation",
    "webRequest",
    "storage",
    "activeTab",
    "scripting",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/safe_16.png",
    "32": "icons/safe_32.png",
    "48": "icons/safe_48.png",
    "128": "icons/safe_128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.google.com/search*",
        "*://*.bing.com/search*"
      ],
      "js": [
        "content/search-protection.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Verity: Website Authenticity",
    "default_icon": {
      "16": "icons/safe_16.png",
      "32": "icons/safe_32.png",
      "48": "icons/safe_48.png",
      "128": "icons/safe_128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "shared/theme.css",
        "content/overlay.css",
        "reports/report.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
{
  "manifest_version": 3,
  "name": "Verity",
  "version": "2.0",
  "description": "Real-time, on-device website protection. Detects phishing, brand impersonation, scams, and financial fraud.",
  "permissions": [
    "webNavigation",
    "webRequest",
    "storage",
    "offscreen",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/safe_16.png",
    "32": "icons/safe_32.png",
    "48": "icons/safe_48.png",
    "128": "icons/safe_128.png"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/ui/icons.js",
        "shared/messages.en.js",
        "content/content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.google.com/search*",
        "*://*.google.com/search*",
        "*://www.bing.com/search*",
        "*://*.bing.com/search*",
        "*://duckduckgo.com/*",
        "*://*.duckduckgo.com/*",
        "*://localhost/*demo/google-search*",
        "*://127.0.0.1/*demo/google-search*"
      ],
      "js": ["content/search/search-loader.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Verity: Web Protection",
    "default_icon": {
      "16": "icons/safe_16.png",
      "32": "icons/safe_32.png",
      "48": "icons/safe_48.png",
      "128": "icons/safe_128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "shared/*",
        "shared/theme.css",
        "shared/ui/*",
        "shared/fonts/*",
        "content/overlay.css",
        "payment-brands.json",
        "config/*",
        "content/search/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}